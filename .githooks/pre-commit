#!/bin/sh
# Rejects commits whose staged C/C++ files don't match .clang-format.
# Fix with: clang-format -i <file>

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cpp|h|hpp|ino)$')
[ -z "$files" ] && exit 0

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found, skipping format check" >&2
    exit 0
fi

failed=0
for f in $files; do
    # Check the staged content, not the working tree
    if ! git show ":$f" | clang-format --assume-filename="$f" --dry-run -Werror >/dev/null 2>&1; then
        echo "not formatted: $f" >&2
        failed=1
    fi
done

if [ $failed -ne 0 ]; then
    printf "\nRun 'clang-format -i <file>' (or save in VS Code) and stage again.\n" >&2
    exit 1
fi
